// 布局全局设置

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
    }

    shadow {
        on
        softness 30
        spread 2
        offset x=-4 y=-4
        color "rgba(0, 0, 0, 0.7)"
    }

    background-color "transparent"
}
