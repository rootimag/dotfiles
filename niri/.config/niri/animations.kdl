// 动画全局设置

animations {
    slowdown 1

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.5 stiffness=800 epsilon=0.0005

        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_progress;
                float alpha = niri_clamped_progress;

                float slide_distance = 50.0;

                float scale = mix(0.85, 1.0, progress);
                scale = max(scale, 0.05);

                vec2 centered = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                centered.y += slide_distance * (1.0 - progress) / size_geo.y;

                coords_geo = vec3(centered, 1.0);

                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);

                return color * alpha;
            }
        "
    }
    window-close {
        duration-ms 340
        curve "linear"

        custom-shader r"
            float hash21(vec2 p) {
                p = fract(p * vec2(123.34, 456.21));
                p += dot(p, p + 45.32);
                return fract(p.x * p.y);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_clamped_progress;

                float band_count = 40.0;
                float band = floor(coords_geo.y * band_count);

                float time_bucket = floor(progress * 14.0);

                vec2 seed_a = vec2(band, time_bucket + niri_random_seed * 97.0);
                vec2 seed_b = vec2(band + 31.0, time_bucket + niri_random_seed * 61.0);
                float r_band = hash21(seed_a);
                float r_amt  = hash21(seed_b);

                float glitch_chance = mix(0.05, 0.6, progress);
                float glitching = step(1.0 - glitch_chance, r_band);

                float max_jitter = 0.06;
                float jitter = (r_amt - 0.5) * 2.0 * max_jitter * glitching;

                vec2 base = coords_geo.xy;
                base.x += jitter;

                float aberration = progress * 0.012;
                vec2 r_uv = base + vec2(aberration, 0.0);
                vec2 g_uv = base;
                vec2 b_uv = base - vec2(aberration, 0.0);

                vec3 tex_r = niri_geo_to_tex * vec3(r_uv, 1.0);
                vec3 tex_g = niri_geo_to_tex * vec3(g_uv, 1.0);
                vec3 tex_b = niri_geo_to_tex * vec3(b_uv, 1.0);

                float r = texture2D(niri_tex, tex_r.st).r;
                vec4 g_sample = texture2D(niri_tex, tex_g.st);
                float b = texture2D(niri_tex, tex_b.st).b;

                vec4 color = vec4(r, g_sample.g, b, g_sample.a);

                float scan = 0.88 + 0.12 * fract(coords_geo.y * band_count);
                color.rgb *= scan;

                float alpha = (1.0 - progress);
                return color * alpha;
            }
        "
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
