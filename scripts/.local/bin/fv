#!/usr/bin/env bash

FONT_ROOT="${HOME}/.local/share/fonts"
TMP_IMG="/tmp/font_preview.png"

render_font() {
    local font_path="$1"
    local font_name="${font_path##*/}"

    magick -size 600x200 xc:none \
        -gravity center \
        -font "$font_path" \
        -pointsize 40 \
        -fill white \
        -annotate +0+0 "Hello Arch 󰣇\n$font_name" \
        "$TMP_IMG"

    kitty icat --clear --transfer-mode=file --unicode-placeholder --stdin=no "$TMP_IMG"

    echo "按任意键返回..."
    read -n 1 -s
}

while getopts "f:" opt; do
  case $opt in
    f)
      if [[ -f "$OPTARG" ]]; then
          render_font "$OPTARG"
          exit 0
      else
          echo "错误: 文件 $OPTARG 不存在"
          exit 1
      fi
      ;;
    *)
      echo "用法: $0 [-f 字体文件路径]"
      exit 1
      ;;
  esac
done

find "$FONT_ROOT" -type f \( -name "*.ttf" -o -name "*.otf" \) | \
    fzf --prompt="󰛖 选择字体 (保持目录结构) > " \
        --preview="$0 -f {}" \
        --preview-window=bottom:60%
